{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: run_planner (.venv)",
            "type": "debugpy",
            "request": "launch",
            "purpose": ["debug-in-terminal"],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "program": "${workspaceFolder}/run_planner.py",
            "args": ["--config", "example_config.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
